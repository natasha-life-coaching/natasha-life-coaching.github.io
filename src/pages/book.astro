---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalEmbed from '../components/common/CalEmbed.astro';
---

<BaseLayout
  title="Book a Session"
  description="Schedule your coaching session with Tash Life Coaching. Choose from discovery calls, online coaching, or returning client sessions."
>
  <!-- Hero Section -->
  <section class="py-16 bg-gradient-to-br from-primary-50/80 via-white/70 to-secondary-50/80 backdrop-blur-sm">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 bg-primary-100 text-primary-600 rounded-full text-sm font-medium mb-4">
        Book Your Session
      </span>
      <h1 class="text-4xl sm:text-5xl font-heading font-semibold text-charcoal mb-6">
        Let's Start Your Journey
      </h1>
      <p class="text-xl text-charcoal/70 leading-relaxed max-w-2xl mx-auto">
        Choose a session type below and pick a time that works for you. All sessions are conducted virtually via Zoom.
      </p>
    </div>
  </section>

  <!-- Booking Options -->
  <section class="py-16 bg-warm-white/70 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Discovery Call -->
        <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-8 shadow-soft text-center">
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-primary-100 flex items-center justify-center">
            <svg class="w-8 h-8 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-heading font-semibold text-charcoal mb-2">Discovery Call</h3>
          <p class="text-3xl font-bold text-primary-500 mb-2">Free</p>
          <p class="text-charcoal/60 mb-6">60 minutes</p>
          <p class="text-charcoal/70 mb-8 text-sm">
            Let's get to know each other! We'll discuss your goals and see if coaching is the right fit for you.
          </p>
          <CalEmbed eventType="discovery" buttonText="Book Free Call" variant="primary" size="lg" />
        </div>

        <!-- Online Coaching - Featured -->
        <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-8 shadow-warm text-center ring-2 ring-secondary-300 relative">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2">
            <span class="bg-secondary-400 text-white px-4 py-1 rounded-full text-sm font-medium">
              Most Popular
            </span>
          </div>
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-secondary-100 flex items-center justify-center">
            <svg class="w-8 h-8 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-heading font-semibold text-charcoal mb-2">Online Coaching</h3>
          <p class="text-3xl font-bold text-secondary-500 mb-2">$70</p>
          <p class="text-charcoal/60 mb-6">60 minutes</p>
          <p class="text-charcoal/70 mb-8 text-sm">
            One-on-one coaching session with personalized guidance. 10 sessions recommended for best results.
          </p>
          <CalEmbed eventType="coaching" buttonText="Book Session" variant="secondary" size="lg" />
        </div>

        <!-- Returning Client -->
        <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-8 shadow-soft text-center">
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-primary-100 flex items-center justify-center">
            <svg class="w-8 h-8 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-heading font-semibold text-charcoal mb-2">Returning Client</h3>
          <p class="text-3xl font-bold text-primary-500 mb-2">$60</p>
          <p class="text-charcoal/60 mb-6">60 minutes</p>
          <p class="text-charcoal/70 mb-8 text-sm">
            Welcome back! Discounted rate for past clients continuing their growth journey.
          </p>
          <CalEmbed eventType="returning" buttonText="Book Session" variant="primary" size="lg" />
        </div>
      </div>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="py-16 bg-warm-cream/70 backdrop-blur-sm">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-semibold text-charcoal mb-8 text-center">
        What to Expect
      </h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center flex-shrink-0">
            <span class="text-primary-600 font-bold">1</span>
          </div>
          <div>
            <h3 class="font-semibold text-charcoal mb-1">Choose Your Time</h3>
            <p class="text-charcoal/70 text-sm">Select a session type and pick an available slot that works for your schedule.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center flex-shrink-0">
            <span class="text-primary-600 font-bold">2</span>
          </div>
          <div>
            <h3 class="font-semibold text-charcoal mb-1">Confirmation Email</h3>
            <p class="text-charcoal/70 text-sm">You'll receive an email with the Zoom link and calendar invite.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center flex-shrink-0">
            <span class="text-primary-600 font-bold">3</span>
          </div>
          <div>
            <h3 class="font-semibold text-charcoal mb-1">Reminder Notifications</h3>
            <p class="text-charcoal/70 text-sm">Get reminders 24 hours and 1 hour before your session.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center flex-shrink-0">
            <span class="text-primary-600 font-bold">4</span>
          </div>
          <div>
            <h3 class="font-semibold text-charcoal mb-1">Join Your Session</h3>
            <p class="text-charcoal/70 text-sm">Click the Zoom link at your scheduled time and let's begin!</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Alternative -->
  <section class="py-12 bg-white/70 backdrop-blur-sm">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-charcoal/70">
        Have questions before booking?
        <a href="/contact" class="text-primary-500 hover:text-primary-600 font-medium ml-1">
          Contact me directly
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
