---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import CalEmbed from '../components/common/CalEmbed.astro';
---

<BaseLayout
  title="Contact"
  description="Ready to start your transformation? Book a free discovery call with Tash Life Coaching. Let's explore how coaching can help you achieve your goals."
>
  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-br from-warm-cream via-primary-50 to-secondary-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 bg-primary-100 text-primary-600 rounded-full text-sm font-medium mb-4">
        Get in Touch
      </span>
      <h1 class="text-4xl sm:text-5xl font-heading font-semibold text-charcoal mb-6">
        Let's Start Your Journey
      </h1>
      <p class="text-xl text-charcoal/70 leading-relaxed">
        Ready to take the first step? I'd love to hear from you. Book a free discovery call or send me a message.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 bg-warm-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Contact Form -->
        <div>
          <h2 class="text-2xl font-heading font-semibold text-charcoal mb-6">
            Send a Message
          </h2>
          <form id="contact-form" class="space-y-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="firstName" class="block text-sm font-medium text-charcoal mb-2">
                  First Name
                </label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  required
                  class="w-full px-4 py-3 rounded-soft border border-warm-taupe/30 bg-warm-cream focus:ring-2 focus:ring-primary-300 focus:border-transparent outline-none transition-all"
                  placeholder="Your first name"
                />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium text-charcoal mb-2">
                  Last Name
                </label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  required
                  class="w-full px-4 py-3 rounded-soft border border-warm-taupe/30 bg-warm-cream focus:ring-2 focus:ring-primary-300 focus:border-transparent outline-none transition-all"
                  placeholder="Your last name"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-charcoal mb-2">
                Email Address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-soft border border-warm-taupe/30 bg-warm-cream focus:ring-2 focus:ring-primary-300 focus:border-transparent outline-none transition-all"
                placeholder="you@example.com"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-charcoal mb-2">
                Phone Number <span class="text-charcoal/50">(optional)</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-3 rounded-soft border border-warm-taupe/30 bg-warm-cream focus:ring-2 focus:ring-primary-300 focus:border-transparent outline-none transition-all"
                placeholder="(555) 123-4567"
              />
            </div>

            <div>
              <label for="interest" class="block text-sm font-medium text-charcoal mb-2">
                What are you interested in?
              </label>
              <select
                id="interest"
                name="interest"
                class="w-full px-4 py-3 rounded-soft border border-warm-taupe/30 bg-warm-cream focus:ring-2 focus:ring-primary-300 focus:border-transparent outline-none transition-all"
              >
                <option value="">Select an option...</option>
                <option value="discovery">Free Discovery Call</option>
                <option value="life-clarity">Life Clarity Coaching</option>
                <option value="career">Career Transformation</option>
                <option value="relationships">Relationship Wellness</option>
                <option value="personal-growth">Personal Growth</option>
                <option value="other">Other / General Inquiry</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-charcoal mb-2">
                Your Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-soft border border-warm-taupe/30 bg-warm-cream focus:ring-2 focus:ring-primary-300 focus:border-transparent outline-none transition-all resize-none"
                placeholder="Tell me a bit about yourself and what you're hoping to achieve..."
              ></textarea>
            </div>

            <Button type="submit" variant="secondary" size="lg" class="w-full sm:w-auto">
              Send Message
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
            </Button>
          </form>
          <script is:inline>
            document.getElementById('contact-form')?.addEventListener('submit', (e) => {
              e.preventDefault();
              const f = e.target;
              const get = (n) => (f.elements[n]?.value || '').trim();
              const firstName = get('firstName');
              const lastName  = get('lastName');
              const email     = get('email');
              const phone     = get('phone');
              const interest  = get('interest');
              const message   = get('message');
              const subject = `Coaching inquiry from ${firstName} ${lastName}`.trim();
              const body = [
                `Name: ${firstName} ${lastName}`,
                `Email: ${email}`,
                phone    ? `Phone: ${phone}` : null,
                interest ? `Interested in: ${interest}` : null,
                '',
                'Message:',
                message,
              ].filter(Boolean).join('\n');
              const url = `mailto:nylifecoach4u@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
              window.location.href = url;
            });
          </script>
        </div>

        <!-- Contact Info -->
        <div>
          <h2 class="text-2xl font-heading font-semibold text-charcoal mb-6">
            Other Ways to Connect
          </h2>

          <!-- Book a Call Card -->
          <div class="bg-gradient-to-br from-primary-100 to-primary-200 p-8 rounded-softer mb-8">
            <h3 class="text-xl font-heading font-semibold text-charcoal mb-3">
              Book a Free Discovery Call
            </h3>
            <p class="text-charcoal/70 mb-6">
              Not sure if coaching is right for you? Let's chat! Book a free 60-minute discovery call where we'll discuss your goals and see if we're a good fit.
            </p>
            <CalEmbed eventType="discovery" buttonText="Schedule Now" variant="primary" size="lg" />
          </div>

          <!-- Contact Details -->
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-secondary-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-charcoal">Email</h4>
                <a href="mailto:nylifecoach4u@gmail.com" class="text-primary-500 hover:text-primary-600 transition-colors">
                  nylifecoach4u@gmail.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-secondary-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-charcoal">Phone</h4>
                <a href="tel:+19169697945" class="text-primary-500 hover:text-primary-600 transition-colors">
                  (916) 969-7945
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-charcoal">Location</h4>
                <p class="text-charcoal/70">Sacramento, CA</p>
                <p class="text-sm text-charcoal/50">Virtual sessions available worldwide</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-accent-gold/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-accent-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-charcoal">Response Time</h4>
                <p class="text-charcoal/70">I typically respond within 24-48 hours</p>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="mt-10 pt-8 border-t border-warm-taupe/20">
            <h4 class="font-semibold text-charcoal mb-4">Follow Along</h4>
            <div class="flex gap-4">
              <a
                href="https://www.instagram.com/nylifecoaching/"
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-full bg-warm-cream hover:bg-primary-100 flex items-center justify-center transition-colors group"
                aria-label="Instagram"
              >
                <svg class="w-6 h-6 text-charcoal/60 group-hover:text-primary-500 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/>
                </svg>
              </a>
              <a
                href="https://www.linkedin.com/in/natasha-yerramilli"
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-full bg-warm-cream hover:bg-primary-100 flex items-center justify-center transition-colors group"
                aria-label="LinkedIn"
              >
                <svg class="w-6 h-6 text-charcoal/60 group-hover:text-primary-500 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 bg-warm-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-semibold text-charcoal mb-12 text-center">
        Frequently Asked Questions
      </h2>

      <div class="space-y-6">
        <details class="bg-warm-white rounded-soft p-6 shadow-soft group">
          <summary class="flex justify-between items-center cursor-pointer list-none font-semibold text-charcoal">
            What happens in a discovery call?
            <svg class="w-5 h-5 text-primary-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="mt-4 text-charcoal/70">
            Our discovery call is a free, no-pressure 30-minute conversation where we get to know each other. We'll discuss your goals, challenges, and what you're hoping to achieve. It's also a chance for you to ask questions about my coaching approach and see if we're a good fit to work together.
          </p>
        </details>

        <details class="bg-warm-white rounded-soft p-6 shadow-soft group">
          <summary class="flex justify-between items-center cursor-pointer list-none font-semibold text-charcoal">
            How long does coaching typically last?
            <svg class="w-5 h-5 text-primary-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="mt-4 text-charcoal/70">
            The duration depends on your goals. Some clients see significant progress in 4-6 sessions, while deeper transformations typically require 3-6 months of consistent work. We'll discuss realistic timelines during your discovery call based on what you want to achieve.
          </p>
        </details>

        <details class="bg-warm-white rounded-soft p-6 shadow-soft group">
          <summary class="flex justify-between items-center cursor-pointer list-none font-semibold text-charcoal">
            Do you offer virtual sessions?
            <svg class="w-5 h-5 text-primary-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="mt-4 text-charcoal/70">
            Absolutely! All my sessions are available virtually via Zoom, making coaching accessible no matter where you are. Virtual sessions are just as effective as in-person meetings and offer added flexibility.
          </p>
        </details>

        <details class="bg-warm-white rounded-soft p-6 shadow-soft group">
          <summary class="flex justify-between items-center cursor-pointer list-none font-semibold text-charcoal">
            What's the difference between coaching and therapy?
            <svg class="w-5 h-5 text-primary-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="mt-4 text-charcoal/70">
            While therapy often focuses on healing past traumas and mental health conditions, coaching is future-focused and action-oriented. We work on setting and achieving goals, developing new skills, and creating positive change. Coaching is not a substitute for therapy if you're dealing with mental health issues.
          </p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
