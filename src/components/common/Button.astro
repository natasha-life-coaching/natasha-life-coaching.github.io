---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button'
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center font-medium transition-all duration-200 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2';

const variants = {
  primary: 'bg-primary-300 hover:bg-primary-400 text-warm-white focus:ring-primary-300 shadow-soft',
  secondary: 'bg-secondary-300 hover:bg-secondary-400 text-warm-white focus:ring-secondary-300 shadow-warm',
  outline: 'border-2 border-primary-300 text-primary-500 hover:bg-primary-50 focus:ring-primary-300',
  ghost: 'text-charcoal hover:bg-warm-taupe/10 focus:ring-warm-taupe',
};

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-2.5 text-base',
  lg: 'px-8 py-3.5 text-lg',
};

const classes = `${baseClasses} ${variants[variant]} ${sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
