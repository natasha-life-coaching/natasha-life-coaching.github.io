---
const testimonials = [
  {
    quote: "Sessions with Natasha are one of the highlights of my week. She's a pleasure to talk to, and often has simple but excellent suggestions on how to make life a little easier.",
    author: "Debbie V.",
    location: "California",
    initials: "DV",
    rating: 5,
  },
  {
    quote: "Natasha is incredibly connected when she's working with you. She has emotional intelligence beyond her years. She's also kind and warm and funny and we laughed a lot during our sessions.",
    author: "Randi C.",
    location: "California",
    initials: "RC",
    rating: 5,
  },
  {
    quote: "Natasha knows exactly which questions to ask. She can synthesize our conversations and turn my busy thoughts into concrete suggestions.",
    author: "Iris T.",
    location: "Vienna",
    initials: "IT",
    rating: 5,
  },
];
---

<section class="py-20 bg-gradient-to-br from-primary-50 via-warm-cream to-secondary-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-1.5 bg-primary-100 text-primary-600 rounded-full text-sm font-medium mb-4">
        Success Stories
      </span>
      <h2 class="text-3xl sm:text-4xl font-heading font-semibold text-charcoal mb-4">
        What My Clients Say
      </h2>
      <p class="text-lg text-charcoal/70">
        Real transformations from real people who took the leap to invest in themselves.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((testimonial, index) => (
        <div
          class="relative bg-warm-white p-8 rounded-softer shadow-soft"
          style={`animation-delay: ${index * 150}ms`}
        >
          <!-- Quote Mark -->
          <div class="absolute -top-4 left-8">
            <div class="w-10 h-10 bg-secondary-300 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-warm-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>
          </div>

          <!-- Rating -->
          <div class="flex gap-1 mb-4 mt-4">
            {[...Array(testimonial.rating)].map(() => (
              <svg class="w-5 h-5 text-accent-gold" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-charcoal/80 leading-relaxed mb-6">
            "{testimonial.quote}"
          </blockquote>

          <!-- Author -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary-200 to-secondary-200 flex items-center justify-center">
              <span class="text-primary-600 font-semibold">
                {testimonial.initials}
              </span>
            </div>
            <div>
              <p class="font-semibold text-charcoal">{testimonial.author}</p>
              <p class="text-sm text-charcoal/60">{testimonial.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Link to all testimonials -->
    <div class="text-center mt-12">
      <a
        href="/testimonials"
        class="inline-flex items-center gap-2 text-primary-500 hover:text-primary-600 font-medium transition-colors"
      >
        Read More Success Stories
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
