---
import Button from '../common/Button.astro';

const services = [
  {
    icon: 'compass',
    title: 'Life Clarity Coaching',
    description: 'Gain crystal-clear vision of your goals and create actionable steps to achieve your dreams.',
    color: 'primary',
  },
  {
    icon: 'briefcase',
    title: 'Career Transformation',
    description: 'Navigate career transitions with confidence and find work that aligns with your purpose.',
    color: 'secondary',
  },
  {
    icon: 'heart',
    title: 'Relationship Wellness',
    description: 'Build healthier relationships and develop stronger communication skills.',
    color: 'accent',
  },
  {
    icon: 'sun',
    title: 'Personal Growth',
    description: 'Unlock your potential, overcome limiting beliefs, and become your best self.',
    color: 'primary',
  },
];
---

<section class="py-20 bg-warm-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-1.5 bg-secondary-100 text-secondary-600 rounded-full text-sm font-medium mb-4">
        How I Can Help
      </span>
      <h2 class="text-3xl sm:text-4xl font-heading font-semibold text-charcoal mb-4">
        Coaching Services Tailored to Your Journey
      </h2>
      <p class="text-lg text-charcoal/70">
        Every path to growth is unique. I offer personalized coaching programs designed to meet you exactly where you are.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service, index) => (
        <div
          class="group p-6 bg-warm-cream rounded-softer hover:shadow-soft transition-all duration-300 hover:-translate-y-1"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class={`w-14 h-14 rounded-soft mb-5 flex items-center justify-center ${
            service.color === 'primary' ? 'bg-primary-100 text-primary-500' :
            service.color === 'secondary' ? 'bg-secondary-100 text-secondary-500' :
            'bg-accent-gold/20 text-accent-gold'
          }`}>
            {service.icon === 'compass' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
            )}
            {service.icon === 'briefcase' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            )}
            {service.icon === 'heart' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            )}
            {service.icon === 'sun' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
            )}
          </div>
          <h3 class="text-xl font-heading font-semibold text-charcoal mb-2 group-hover:text-primary-500 transition-colors">
            {service.title}
          </h3>
          <p class="text-charcoal/70 text-sm leading-relaxed">
            {service.description}
          </p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <Button href="/services" variant="primary" size="lg">
        View All Services
      </Button>
    </div>
  </div>
</section>
