---
import Button from '../common/Button.astro';
---

<section class="py-20 bg-warm-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Image -->
      <div class="relative order-2 lg:order-1">
        <div class="relative max-w-md mx-auto">
          <!-- Decorative background -->
          <div class="absolute -inset-4 bg-gradient-to-br from-primary-200 to-secondary-200 rounded-[2rem] transform -rotate-2"></div>

          <!-- Photo -->
          <div class="relative bg-warm-white rounded-[1.5rem] overflow-hidden shadow-soft">
            <img
              src="https://static.wixstatic.com/media/e16bd6_9f89c271f5344d82ad21ad208d7f5938~mv2.jpeg/v1/fill/w_573,h_1120,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/e16bd6_9f89c271f5344d82ad21ad208d7f5938~mv2.jpeg"
              alt="Natasha Yerramilli - Life Coach"
              class="w-full h-auto object-cover"
            />
          </div>

          <!-- Floating badge -->
          <div class="absolute -bottom-4 -right-4 bg-secondary-300 text-warm-white px-6 py-3 rounded-full shadow-warm">
            <span class="font-semibold">Certified</span>
            <span class="text-secondary-100"> Life Coach</span>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="order-1 lg:order-2">
        <span class="inline-block px-4 py-1.5 bg-primary-100 text-primary-600 rounded-full text-sm font-medium mb-4">
          Meet Your Coach
        </span>
        <h2 class="text-3xl sm:text-4xl font-heading font-semibold text-charcoal mb-6">
          Hi, I'm Natasha
        </h2>
        <div class="space-y-4 text-charcoal/70 leading-relaxed mb-8">
          <p>
            Friends call me Tash. I am a certified life coach. I am an open minded person and I will create a safe space where we can explore what is holding you back from reaching your full potential.
          </p>
          <p>
            I can help you set goals and achieve them. My guidance can help you be the best version of yourself! Whether you're navigating a career transition, seeking more fulfillment, or simply feeling stuck, I'm here to walk alongside you on your journey.
          </p>
          <p>
            I also have a podcast called <strong>AmericanDesi</strong>, where I talk about my life experiences. You can get to know me better by listening!
          </p>
        </div>

        <!-- Credentials -->
        <div class="flex flex-wrap gap-4 mb-8">
          <div class="flex items-center gap-2 px-4 py-2 bg-warm-white rounded-full shadow-soft">
            <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-sm font-medium text-charcoal">ICF Certified</span>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 bg-warm-white rounded-full shadow-soft">
            <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            <span class="text-sm font-medium text-charcoal">500+ Sessions</span>
          </div>
        </div>

        <Button href="/about" variant="primary">
          Read My Full Story
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </Button>
      </div>
    </div>
  </div>
</section>
